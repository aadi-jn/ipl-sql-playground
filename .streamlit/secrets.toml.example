# Copy to .streamlit/secrets.toml for local runs, or paste into Streamlit Cloud's
# Secrets UI for the deployed app. NEVER commit the real file — it holds a credential.

app_password = "change-me"

# Paste the contents of the service-account JSON key here, as a TOML table.
# (Each JSON field becomes a key = "value" line.)
[gcp_service_account]
type = "service_account"
project_id = "ipl-nao"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "bq-playground@ipl-nao.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
